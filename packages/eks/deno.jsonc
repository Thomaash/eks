{
  "name": "@tomina/eks",
  "version": "1.3.1",
  "description": "A Deno CLI that discovers runnable scripts (Makefile targets, package.json scripts, Deno tasks) and runs them via a fuzzy picker.",
  "license": "ISC",
  "exports": {
    ".": "./mod.ts"
  },
  "publish": {
    "exclude": [
      "**/*_test.ts",
      "**/fixtures/**",
      "**/stryker.config.json"
    ]
  },
  "tasks": {
    "eks": "deno run --allow-env --allow-read --allow-run --allow-sys --allow-write mod.ts",
    "eks:multiple": "deno run --allow-env --allow-read --allow-run --allow-sys --allow-write mod.ts --multiple",
    "stryker": "npx --yes @stryker-mutator/core run packages/eks/stryker.config.json"
  },
  "imports": {
    "@inquirer/prompts": "npm:@inquirer/prompts@8.5.2",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/cli": "jsr:@std/cli@1.0.29",
    "@std/fs": "jsr:@std/fs@1.0.23",
    "@std/internal": "jsr:@std/internal@1.0.13",
    "@std/jsonc": "jsr:@std/jsonc@1.0.2",
    "@std/path": "jsr:@std/path@1.1.4",
    "fzf": "npm:fzf@0.5.2"
  }
}
